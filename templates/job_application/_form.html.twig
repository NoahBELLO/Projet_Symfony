<turbo-frame id="jobApplication-form">
	<div class="container mb-8 px-5 mx-auto max-w-2xl">
		{% if jobApplication.id %}
			<div class="p-4 mb-5 text-sm text-teal-900 rounded-lg bg-teal-100" role="alert">
				<span class="font-medium">Merci pour votre lettre de motivation !</span>
			</div>
		{% else %}
			<form method="post" action="{{ path('app_job_application_form', { id: jobId }) }}" class="text-gray-900 bg-white p-8 rounded-lg shadow-md" data-turbo-frame="jobApplication-form">
				<div class="mb-6">
					<label for="{{ form.coverLetter.vars.id }}" class="block text-gray-800 font-semibold mb-2">
						Votre lettre de motivation
					</label>
					{{ form_widget(form.coverLetter, {attr: {class: 'w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-teal-400 focus:border-teal-400'}}) }}
				</div>
				<div class="mb-6">
					{% if form_errors(form) %}
						<div class="p-4 mb-4 text-sm text-red-700 rounded-lg bg-red-100" role="alert">
							{{ form_errors(form) }}
						</div>
					{% endif %}
				</div>
				{{ form_row(form._token) }}
				<button type="submit" class="cursor-pointer px-6 py-2 bg-teal-500 text-white font-semibold rounded-md hover:bg-teal-600 focus:outline-none focus:ring-2 focus:ring-teal-500 focus:ring-offset-2 transition">
					Postuler
				</button>
			</form>
		{% endif %}
	</div>
</turbo-frame>
