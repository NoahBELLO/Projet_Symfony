{% extends 'base.html.twig' %}

{% block title %}
	Connexion à Jobiz
{% endblock %}

{% block body %}
	<section class="text-teal-600 bg-slate-700 body-font">
		<div class="container px-5 py-24 mx-auto flex flex-wrap items-center">
			<div class="lg:w-2/6 md:w-1/2 mx-auto bg-slate-600 bg-opacity-50 rounded-lg p-8 flex flex-col
										                md:ml-auto w-full mt-10 md:mt-0">
				{% if app.user %}
					<div class="text-white text-lg font-medium title-font mb-5">
						Vous êtes connecté en tant que
						<strong>{{ app.user.userIdentifier }}</strong>,
						<a class="text-teal-400 hover:underline" href="{{ path('app_logout') }}">Déconnexion</a>
					</div>
				{% else %}
					<form method="post">
						{% if error %}
							<div class="p-4 mb-4 text-sm text-red-400 rounded-lg bg-slate-800" role="alert">
								<span class="font-medium">{{ error.messageKey|trans(error.messageData, 'security') }}</span>
							</div>
						{% endif %}
						<h2 class="text-white text-lg font-medium title-font mb-5">Connexion à votre espace Jobiz</h2>
						<div class="relative mb-4">
							<label for="username" class="leading-7 text-sm text-teal-200">Adresse e-mail ou pseudo</label>
							<input type="text" value="{{ last_username }}" name="_username" id="username" class="w-full bg-slate-500 bg-opacity-20 focus:bg-transparent focus:ring-2 focus:ring-teal-500
																              rounded border border-slate-600 focus:border-teal-400 text-base outline-none text-white py-1 px-3
																              leading-8 transition-colors duration-200 ease-in-out" autocomplete="username" required autofocus>
						</div>
						<div class="relative mb-4">
							<label for="password" class="leading-7 text-sm text-teal-200">Mot de passe</label>
							<input type="password" name="_password" id="password" class="w-full bg-slate-500 bg-opacity-20 focus:bg-transparent focus:ring-2 focus:ring-teal-500
																              rounded border border-slate-600 focus:border-teal-400 text-base outline-none text-white py-1 px-3
																              leading-8 transition-colors duration-200 ease-in-out" autocomplete="current-password" required>
						</div>
						<input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
						<button type="submit" class="text-white bg-teal-600 border-0 py-2 px-8 focus:outline-none hover:bg-teal-700 rounded text-lg">
							Se connecter
						</button>
					</form>
				{% endif %}
			</div>
		</div>
	</section>
{% endblock %}
