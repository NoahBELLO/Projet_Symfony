{% extends 'base.html.twig' %}

{% block title %}
	{{ title }}
{% endblock %}

{% block body %}
	<section class="text-teal-600 bg-slate-700 body-font">
		<div class="container mx-auto flex px-5 py-24 md:flex-row flex-col items-center">
			<div class="lg:flex-grow md:w-1/2 lg:pr-24 md:pr-16 flex flex-col md:items-start md:text-left mb-16 md:mb-0 items-center text-center">
				<h1 class="title-font sm:text-4xl text-3xl mb-4 font-medium text-white">
					{{ title }}
				</h1>
				<p class="mb-8 leading-relaxed">
					Trouvez des offres d’emploi qui vous correspondent, postulez en quelques clics, et suivez vos candidatures depuis une seule interface. Gagnez du temps dans votre recherche d’emploi avec Jobiz.
				</p>
				<div class="flex justify-center">
					<a class="inline-flex text-teal-600 border-2 border-teal-600 hover:bg-teal-600 hover:text-white transition-colors py-2 px-6 rounded text-lg" href="#">
						Voir les offres
					</a>
				</div>
			</div>
			<div class="lg:max-w-lg lg:w-full md:w-1/2 w-5/6">
				<img class="object-cover object-center rounded" src="{{ asset('images/logo-jobiz.png') }}" alt="Jobiz">
			</div>
		</div>
	</section>
{% endblock %}
