{% extends 'base.html.twig' %}
{% block title %}
	{{title}}
	- Jobiz
{% endblock %}
{% block body %}
	<section class="text-teal-600 bg-slate-700 body-font">
		<div class="container mx-auto flex px-5 py-24 items-center justify-center flex-col">
			<img class="lg:w-2/6 md:w-3/6 w-5/6 mb-10 object-cover object-center rounded" src="{{ asset('images/logo-jobiz.png') }}" alt="Jobiz"/>
			<div class="text-center lg:w-2/3 w-full">
				<h1 class="title-font sm:text-4xl text-3xl mb-4 font-medium text-white">
					À propos
				</h1>
				<p class="leading-relaxed mb-8">
					Jobiz est une plateforme dédiée à faciliter la rencontre entre les talents et les opportunités professionnelles. 
					        Nous croyons que chaque profil mérite de trouver un emploi qui correspond à ses aspirations. 
					        Que vous soyez en début de carrière, en reconversion ou à la recherche d’un nouveau défi, notre mission est de vous accompagner à chaque étape.
				</p>
			</div>
		</div>
	</section>
{% endblock %}
