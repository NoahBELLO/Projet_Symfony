<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8">
		<title>
			{% block title %}Welcome!
			{% endblock %}
		</title>
		<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>"> {% block stylesheets %}{% endblock %}

		{% block javascripts %}
			{% block importmap %}
				{{ importmap('app') }}
			{% endblock %}
		{% endblock %}
	</head>
	<body class="bg-teal-600 text-teal-600">
		<header class="bg-slate-700 body-font">
			<div class="container mx-auto flex flex-wrap p-5 flex-col md:flex-row items-center">
				<a class="flex title-font font-medium items-center mb-4 md:mb-0" href="#">
					<img width="120" src="{{ asset('images/logo-jobiz.png') }}" alt="Jobiz">
				</a>
				<nav class="md:ml-auto md:mr-auto flex flex-wrap items-center text-base justify-center">
					<a class="mr-5 hover:text-white" href="{{ path('app_home') }}">Accueil</a>
					<a class="mr-5 hover:text-white" href="{{ path('app_job_list') }}">Listes de jobs</a>
					<a class="mr-5 hover:text-white" href="{{ path('app_about') }}">À propos</a>
				</nav>
				{% if app.user %}
					<a class="inline-flex items-center border-2 border-teal-600 text-teal-600 hover:bg-teal-600 hover:text-white transition-colors py-2 px-3 ml-10 rounded text-base mt-4 md:mt-0" href="{{ path('app_logout') }}">
						Déconnexion
					</a>
				{% else %}
					<a class="inline-flex items-center border-2 border-teal-600 text-teal-600 hover:bg-teal-600 hover:text-white transition-colors py-2 px-3 ml-10 rounded text-base mt-4 md:mt-0" href="{{ path('app_login') }}">
						Connexion
					</a>
				{% endif %}

				{% if is_granted('ROLE_ADMIN') %}
					<a class="inline-flex items-center border-2 border-teal-600 text-teal-600 hover:bg-teal-600 hover:text-white transition-colors py-2 px-3 ml-10 rounded text-base mt-4 md:mt-0" href="{{ path('admin') }}">
						Admin
					</a>
				{% endif %}
			</div>
		</header>

		{% block body %}{% endblock %}

		<footer class="bg-slate-700 body-font">
			<div class="container px-5 py-8 mx-auto flex items-center sm:flex-row flex-col">
				<a class="flex title-font font-medium items-center md:justify-start justify-center" href="#">
					<img width="70" src="{{ asset('images/logo-jobiz.png') }}" alt="Jobiz">
				</a>
				<p class="text-sm sm:ml-4 sm:pl-4 sm:border-l-2 sm:border-teal-600 sm:py-2 sm:mt-0 mt-4">
					©
					{{ 'now' | date('Y') }}
					Jobiz
				</p>
				<span class="inline-flex sm:ml-auto sm:mt-0 mt-4 justify-center sm:justify-start">
					<a class="hover:text-white transition-colors">
						<svg fill="currentColor" class="w-5 h-5" viewbox="0 0 24 24">
							<path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"></path>
						</svg>
					</a>
					<a class="ml-3 hover:text-white transition-colors">
						<svg fill="currentColor" class="w-5 h-5" viewbox="0 0 24 24">
							<path d="M23 3a10.9 10.9 0 01-3.14 1.53A4.48 4.48 0 0012 7.5v1A10.66 10.66 0 013 4s-4 9 5 13a11.64 11.64 0 01-7 2c9 5 20 0 20-11.5a4.5 4.5 0 00-.08-.83A7.72 7.72 0 0023 3z"></path>
						</svg>
					</a>
					<a class="ml-3 hover:text-white transition-colors">
						<svg fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5" viewbox="0 0 24 24">
							<rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
							<path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37zm1.5-4.87h.01"></path>
						</svg>
					</a>
					<a class="ml-3 hover:text-white transition-colors">
						<svg fill="currentColor" stroke="currentColor" stroke-width="0" class="w-5 h-5" viewbox="0 0 24 24">
							<path stroke="none" d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2z"></path>
							<circle cx="4" cy="4" r="2" stroke="none"></circle>
						</svg>
					</a>
				</span>
			</div>
		</footer>
	</body>
</html>
